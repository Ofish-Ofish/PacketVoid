# Specific Build Output Files
*.tlog
*.log
*.lastbuildstate
*.recipe

# ==========================================
# Visual Studio Build Output Directories
# ==========================================
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Oo]bj/
[Bb]in/

# ==========================================
# Binaries, Libraries & Shared Objects
# ==========================================
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.so
*.so.*
*.dylib
*.sys

# Ignore all libraries and DLLs by default...
*.lib
*.a
*.la
*.lo
*.dll

# ==========================================
# Whitelist Vendor Dependencies
# ==========================================
# Allow everything inside any vendor directory (including .lib, .dll, .sys)
!**/vendor/**
!**/vendor/**/